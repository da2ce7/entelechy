# .clang-tidy — Static analysis configuration for CPU kernel C sources (ADR-015).
#
# Run: clang-tidy -p builddir src/backends/cpu/kernel_sources/*.c
# Or via the lint script: scripts/lint-c.sh
#
# Requires compile_commands.json in builddir/ (generated by Meson).

---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  -misc-unused-parameters,
  performance-*,
  portability-*,
  readability-function-cognitive-complexity,
  readability-identifier-naming,
  readability-misleading-indentation,
  readability-redundant-declaration,

WarningsAsErrors: >
  bugprone-undefined-memory-manipulation,
  bugprone-sizeof-expression,
  bugprone-argument-comment,
  clang-analyzer-core.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*,

CheckOptions:
  - key:   readability-identifier-naming.FunctionCase
    value: lower_case
  - key:   readability-identifier-naming.VariableCase
    value: lower_case
  - key:   readability-identifier-naming.TypedefCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

HeaderFilterRegex: 'cpu_kernels\.h|cpu_simd\.h|cpu_threads\.h|cpu_export\.h'

FormatStyle: file
...
