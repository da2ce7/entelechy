# meson.options — Build feature options for averaging_ensembled_classifier
#
# Debug / sanitizer builds:
#   meson setup builddir-debug -Dbuildtype=debug -Db_sanitize=address,undefined
#   meson setup builddir-release -Dbuildtype=release
#
# Windows DLL cross-compile:
#   meson setup builddir-win --cross-file=cross/x86_64-w64-mingw32.ini
#   meson setup builddir-win --cross-file=cross/msvc.ini
#
# ISA targeting (all platforms):
#   meson setup builddir -Daec_cpu_isa_flags=['-mavx2','-mfma','-mf16c']

option('aec_backend_vulkan', type: 'feature', value: 'enabled',
       description: 'Build Vulkan SPIR-V compute shaders (requires glslc)')

option('aec_backend_cpu', type: 'feature', value: 'enabled',
       description: 'Build CPU SIMD kernel shared library')

option('aec_backend_opencl', type: 'feature', value: 'enabled',
       description: 'OpenCL backend via PyOpenCL (runtime kernel compilation)')

option('aec_cpu_isa_flags', type: 'array', value: [],
       description: 'C compiler ISA flags for CPU backend (e.g., [\'-mavx2\']. Empty = -march=native)')

option('aec_cpu_debug_asserts', type: 'boolean', value: false,
       description: 'Enable CPU kernel runtime assertions (bounds checks, NaN guards)')

option('feature_ticket_api', type: 'boolean', value: true,
       description: 'WorkTicket / Engine user-facing API (ADR-018) — enabled by default since Phase 11 complete')
