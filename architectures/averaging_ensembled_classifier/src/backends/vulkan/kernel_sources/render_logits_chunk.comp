// render_logits.comp — Node 5: Module-layer logit computation
//
// Algorithmic reference: kernels.cl.h §render_logits_chunk
// Dispatch: vkCmdDispatch(tile_count, 1, 1)
//   gl_WorkGroupID.x → flat tile index encoding (module_chunk, batch, class_chunk)
// Each invocation computes one logit element via dot product over hidden dim.

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

// ── Push Constants ─────────────────────────────────────────────────────
layout(push_constant) uniform PushConstants {
    uint batch_chunk_offset;
    uint batch_chunk_count;
    uint module_chunk_offset;
    uint module_chunk_count;
    uint class_chunk_offset;
    uint class_chunk_count;
    uint total_batch_count;
    uint hidden_count;
    uint padded_hidden_count;
    uint total_output_class_count;
    uint padded_total_output_class_count;
    uint total_modules_count;
    uint FLAG_use_explicit_hidden_mask;
} push;

// ── Descriptor Bindings ────────────────────────────────────────────────
layout(set = 0, binding = 0) readonly buffer HiddenBuf  { STORAGE_TYPE data[]; } src_hidden;
layout(set = 0, binding = 1) readonly buffer HMaskBuf   { STORAGE_TYPE data[]; } src_hidden_mask;
layout(set = 0, binding = 2) readonly buffer SMaskBuf   { uint data[]; } src_sample_mask;
layout(set = 0, binding = 3) readonly buffer WeightsBuf { STATE_TYPE   data[]; } src_weights;
layout(set = 0, binding = 4) readonly buffer BiasesBuf  { STATE_TYPE   data[]; } src_biases;
layout(set = 0, binding = 5) writeonly buffer LogitsBuf { STORAGE_TYPE data[]; } dest_logits;

void main() {
    // 3D logical mapping from invocation index
    uint gid = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;

    uint total_work = push.module_chunk_count * push.batch_chunk_count * push.class_chunk_count;
    if (gid >= total_work) return;

    // Decompose flat index → (module_local, batch_local, class_local)
    uint class_local_idx  = gid % push.class_chunk_count;
    uint rem              = gid / push.class_chunk_count;
    uint batch_local_idx  = rem % push.batch_chunk_count;
    uint module_local_idx = rem / push.batch_chunk_count;

    uint module_global_idx = push.module_chunk_offset + module_local_idx;
    uint batch_global_idx  = push.batch_chunk_offset + batch_local_idx;
    uint class_global_idx  = push.class_chunk_offset + class_local_idx;

    // Output address — idx_u64() intermediates prevent overflow on large tensor products
    uint out_idx = uint(idx_u64(module_global_idx) * idx_u64(push.total_batch_count) * idx_u64(push.padded_total_output_class_count)
                      + idx_u64(batch_global_idx) * idx_u64(push.padded_total_output_class_count)
                      + idx_u64(class_global_idx));

    // ADR-031: Sample mask early-exit
    if (load_sample_mask(src_sample_mask.data[batch_global_idx >> 5u], batch_global_idx) == 0u) {
        dest_logits.data[out_idx] = write_storage(COMPUTE_TYPE(0.0));
        return;
    }

    // Initialize with bias
    COMPUTE_TYPE logit = read_state(src_biases.data[uint(idx_u64(module_global_idx) * idx_u64(push.padded_total_output_class_count) + idx_u64(class_global_idx))]);

    // Sparse dot product over hidden dimension
    uint hidden_base = uint(idx_u64(batch_global_idx) * idx_u64(push.padded_hidden_count));
    for (uint h = 0; h < push.hidden_count; ++h) {
        COMPUTE_TYPE h_val = read_storage(src_hidden.data[hidden_base + h]);

        // Determine ReLU mask: explicit from buffer or derived from activation.
        COMPUTE_TYPE h_mask;
        if (push.FLAG_use_explicit_hidden_mask != 0u) {
            h_mask = read_storage(src_hidden_mask.data[hidden_base + h]);
        } else {
            h_mask = (h_val > COMPUTE_TYPE(0.0))
                     ? COMPUTE_TYPE(1.0) : COMPUTE_TYPE(0.0);
        }

        if (h_mask > COMPUTE_TYPE(0.5)) {
            uint w_idx = uint(idx_u64(module_global_idx) * idx_u64(push.padded_hidden_count) * idx_u64(push.padded_total_output_class_count)
                            + idx_u64(h) * idx_u64(push.padded_total_output_class_count)
                            + idx_u64(class_global_idx));
            COMPUTE_TYPE w_val = read_state(src_weights.data[w_idx]);
            logit += h_val * w_val;
        }
    }

    dest_logits.data[out_idx] = write_storage(logit);
}
