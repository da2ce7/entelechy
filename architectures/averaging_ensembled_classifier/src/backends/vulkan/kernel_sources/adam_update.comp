// adam_update.comp — Node 24: Adam optimizer parameter update
//
// Algorithmic reference: kernels.cl.h §adam_update
// Embarrassingly parallel element-wise kernel.
// Updates parameters and first/second moment vectors using the Adam rule.
// beta1_pow_t and beta2_pow_t are pre-computed on the host in FP64
// (Contract: no on-device power calculations for long-term stability).
//
// State-Precision Accumulation (ADR-027):
//   - EMA updates and parameter subtraction in ACCUM_FLOAT = max(COMPUTE_TYPE, STATE_TYPE)
//   - Bias correction and delta computation in COMPUTE_TYPE
//   - When ACCUM_FLOAT == COMPUTE_TYPE, all casts are identity operations
//
// Dispatch: vkCmdDispatch(ceil(parameter_count / SIMD_WIDTH), 1, 1)
// Dispatched per parameter group (weights, biases, temps, shared_w, shared_b)
// with different buffer bindings.

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    float learning_rate;
    float beta1_pow_t;
    float beta2_pow_t;
    float beta1;
    float beta2;
    float epsilon;
    uint  parameter_count;
} push;

layout(set = 0, binding = 0) readonly buffer GradBuf   { COMPUTE_TYPE data[]; } grads;
layout(set = 0, binding = 1) buffer ParamBuf            { STATE_TYPE data[]; } params;
layout(set = 0, binding = 2) buffer M1Buf               { STATE_TYPE data[]; } m1;
layout(set = 0, binding = 3) buffer M2Buf               { STATE_TYPE data[]; } m2;

void main() {
    uint i = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (i >= push.parameter_count) return;

    // Load gradient in COMPUTE_TYPE (precision role: compute)
    COMPUTE_TYPE g = grads.data[i];

    // State-Precision Accumulation: load moments at full state precision
    ACCUM_FLOAT m_prev = LOAD_STATE_FOR_ACCUM(m1.data[i]);
    ACCUM_FLOAT v_prev = LOAD_STATE_FOR_ACCUM(m2.data[i]);

    // EMA updates in ACCUM_FLOAT (preserves state precision)
    ACCUM_FLOAT g_accum     = WIDEN_TO_ACCUM(g);
    ACCUM_FLOAT beta1_accum = WIDEN_TO_ACCUM(COMPUTE_TYPE(push.beta1));
    ACCUM_FLOAT beta2_accum = WIDEN_TO_ACCUM(COMPUTE_TYPE(push.beta2));

    // First moment: m_new = β₁ · m_prev + (1 - β₁) · g
    ACCUM_FLOAT m_new = beta1_accum * m_prev +
                        (ACCUM_FLOAT(1.0) - beta1_accum) * g_accum;

    // Second moment: v_new = β₂ · v_prev + (1 - β₂) · g²
    ACCUM_FLOAT v_new = beta2_accum * v_prev +
                        (ACCUM_FLOAT(1.0) - beta2_accum) * (g_accum * g_accum);

    // Store updated moments at state precision
    m1.data[i] = STORE_STATE_FROM_ACCUM(m_new);
    m2.data[i] = STORE_STATE_FROM_ACCUM(v_new);

    // Bias correction in COMPUTE_TYPE (transformative)
    COMPUTE_TYPE m_hat = NARROW_FROM_ACCUM(m_new) /
                         (COMPUTE_TYPE(1.0) - COMPUTE_TYPE(push.beta1_pow_t));
    COMPUTE_TYPE v_hat = NARROW_FROM_ACCUM(v_new) /
                         (COMPUTE_TYPE(1.0) - COMPUTE_TYPE(push.beta2_pow_t));

    // Parameter update: delta in COMPUTE_TYPE, subtraction in ACCUM_FLOAT (accumulative)
    COMPUTE_TYPE param_delta = COMPUTE_TYPE(push.learning_rate) * m_hat /
                               (sqrt(v_hat) + COMPUTE_TYPE(push.epsilon));

    ACCUM_FLOAT current_param = LOAD_STATE_FOR_ACCUM(params.data[i]);
    params.data[i] = STORE_STATE_FROM_ACCUM(current_param - WIDEN_TO_ACCUM(param_delta));
}
