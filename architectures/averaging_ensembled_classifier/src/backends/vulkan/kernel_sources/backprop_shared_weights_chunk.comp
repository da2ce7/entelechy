// backprop_shared_weights.comp — Node 17: Shared weight gradients (streaming)
//
// Algorithmic reference: kernels.cl.h §backprop_shared_weights_chunk
// "Work-group per gradient" reduction: each workgroup computes one scalar
// gradient dL/dW_ij by reducing contributions across all samples in a batch chunk.
//
// Dispatch: vkCmdDispatch(padded_input_count, padded_hidden_count, 1)
//   gl_WorkGroupID.x → input dimension (i_idx)
//   gl_WorkGroupID.y → hidden dimension (j_idx)
// Dispatched per streaming chunk; batch_chunk_offset/index updated via push constants.

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    uint batch_chunk_offset;
    uint batch_chunk_count;
    uint batch_chunk_index;
    uint total_batch_count;
    uint num_batch_chunks;
    uint input_count;
    uint padded_input_count;
    uint hidden_count;
    uint padded_hidden_count;
    uint final_grad_hidden_total_element_count;
    uint FLAG_use_explicit_hidden_mask;
} push;

layout(set = 0, binding = 0) readonly buffer InputBuf      { STORAGE_TYPE data[]; } input_buf;
layout(set = 0, binding = 1) readonly buffer HiddenBuf     { STORAGE_TYPE data[]; } hidden_acts;
layout(set = 0, binding = 2) readonly buffer GradHBuf      { COMPUTE_TYPE data[]; } grad_h;
layout(set = 0, binding = 3) readonly buffer SampleMaskBuf { uint data[]; } sample_mask;
layout(set = 0, binding = 4) readonly buffer HiddenMaskBuf { STORAGE_TYPE data[]; } hidden_mask;
layout(set = 0, binding = 5) writeonly buffer GradSWOut    { STORAGE_TYPE data[]; } grad_sw_out;

void main() {
    uint i_idx = gl_WorkGroupID.x;  // input dimension
    uint j_idx = gl_WorkGroupID.y;  // hidden dimension
    uint lid   = gl_LocalInvocationID.x;
    uint lsize = gl_WorkGroupSize.x;

    if (i_idx >= push.padded_input_count || j_idx >= push.padded_hidden_count) return;

    // ── Padding Zero-Establishment (CONTRACT.md) ──
    // The kernel is the sole guarantor of zeros at padding positions.
    bool is_padding = (i_idx >= push.input_count) || (j_idx >= push.hidden_count);
    if (is_padding) {
        if (lid == 0) {
            uint hb   = j_idx / SPEC_SIMD_WIDTH;
            uint lane = j_idx % SPEC_SIMD_WIDTH;
            uint chunk_base = uint(idx_u64(push.batch_chunk_index) * idx_u64(push.padded_input_count) * idx_u64(push.padded_hidden_count));
            uint grad_w_idx = uint(idx_u64(chunk_base) + idx_u64(hb) * idx_u64(push.padded_input_count) * idx_u64(SPEC_SIMD_WIDTH) + idx_u64(i_idx) * idx_u64(SPEC_SIMD_WIDTH) + idx_u64(lane));
            grad_sw_out.data[grad_w_idx] = write_storage(COMPUTE_TYPE(0.0));
        }
        return;
    }

    // ── Parallel reduction over the batch chunk ──
    COMPUTE_TYPE p_grad_sw = COMPUTE_TYPE(0.0);

    for (uint b_local = lid; b_local < push.batch_chunk_count; b_local += lsize) {
        uint b_global = push.batch_chunk_offset + b_local;

        // Skip padded samples.
        if (load_sample_mask(sample_mask.data[b_global >> 5u], b_global) == 0u) continue;

        // Chain rule: dL/dW_ij = (dL/dA_j) * (dA_j/dZ_j) * (dZ_j/dW_ij)
        uint  hidden_offset = uint(idx_u64(b_global) * idx_u64(push.padded_hidden_count) + idx_u64(j_idx));
        COMPUTE_TYPE grad_h_val    = grad_h.data[hidden_offset];       // dL/dA_j (compute-role)
        COMPUTE_TYPE hidden_val    = read_storage(hidden_acts.data[hidden_offset]);

        // ReLU derivative: dA_j/dZ_j — FLAG-conditional source (ADR-031)
        COMPUTE_TYPE d_activation;
        if (push.FLAG_use_explicit_hidden_mask != 0u) {
            d_activation = read_storage(hidden_mask.data[hidden_offset]);
        } else {
            d_activation = (hidden_val > COMPUTE_TYPE(0.0)) ? COMPUTE_TYPE(1.0) : COMPUTE_TYPE(0.0);
        }
        COMPUTE_TYPE dL_dZ_j      = grad_h_val * d_activation;

        // dZ_j/dW_ij = input value
        COMPUTE_TYPE input_val = read_storage(input_buf.data[uint(idx_u64(b_global) * idx_u64(push.padded_input_count) + idx_u64(i_idx))]);
        p_grad_sw += dL_dZ_j * input_val;
    }

    // ── Subgroup-accelerated workgroup reduction ──
    COMPUTE_TYPE total = workgroup_reduce_add(p_grad_sw);

    // Leader writes the final reduced partial gradient for this chunk.
    // Write uses SIMD-major (SoA) layout: (h_block, padded_input, SIMD_lane) — matching
    // the forward_pass kernel's weight buffer layout. This ensures flat-index
    // correspondence between gradient and parameter buffers for Adam.
    if (lid == 0) {
        uint hb   = j_idx / SPEC_SIMD_WIDTH;
        uint lane = j_idx % SPEC_SIMD_WIDTH;
        uint chunk_base = uint(idx_u64(push.batch_chunk_index) * idx_u64(push.padded_input_count) * idx_u64(push.padded_hidden_count));
        uint grad_w_idx = uint(idx_u64(chunk_base) + idx_u64(hb) * idx_u64(push.padded_input_count) * idx_u64(SPEC_SIMD_WIDTH) + idx_u64(i_idx) * idx_u64(SPEC_SIMD_WIDTH) + idx_u64(lane));
        grad_sw_out.data[grad_w_idx] = write_storage(total);
    }
}
