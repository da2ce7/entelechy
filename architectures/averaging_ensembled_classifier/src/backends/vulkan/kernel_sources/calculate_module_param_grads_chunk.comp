// calculate_module_param_grads.comp — Node 8: Module weight & bias gradients
//
// Algorithmic reference: kernels.cl.h §calculate_module_param_grads_chunk
// Strategy A: SPEC_PROBLEM_TYPE specialization constant selects CCE/BCE path.
// Dispatch: vkCmdDispatch(total_tile_count, 1, 1)
//   gl_WorkGroupID.x → flat tile index (replaces host-provided flat_tile_index)
// Work-group ID maps to gradient tensor coordinates; threads reduce over batch.

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    uint batch_chunk_offset;
    uint batch_chunk_count;
    uint num_class_chunks;
    uint classes_per_chunk;
    uint modules_per_chunk;
    uint total_batch_count;
    uint hidden_count;
    uint padded_hidden_count;
    uint total_output_class_count;
    uint padded_total_output_class_count;
    uint total_modules_count;
    uint total_tile_count;
} push;

layout(set = 0, binding = 0) readonly buffer HiddenBuf   { STORAGE_TYPE data[]; } src_hidden;
layout(set = 0, binding = 1) readonly buffer ProbsBuf    { STORAGE_TYPE data[]; } src_probs;
layout(set = 0, binding = 2) readonly buffer TargetsBuf  { int           data[]; } src_targets_cce;
layout(set = 0, binding = 3) readonly buffer TargetsBCE  { STORAGE_TYPE data[]; } src_targets_bce;
layout(set = 0, binding = 4) readonly buffer MaskBuf     { uint data[]; } src_sample_mask;
layout(set = 0, binding = 5) writeonly buffer GradWBuf   { STORAGE_TYPE data[]; } dest_grad_w;
layout(set = 0, binding = 6) writeonly buffer GradBBuf   { STORAGE_TYPE data[]; } dest_grad_b;
layout(set = 0, binding = 7) readonly buffer TempsBuf    { STATE_TYPE   data[]; } src_temps;

void main() {
    uint tile_idx = gl_WorkGroupID.x;
    if (tile_idx >= push.total_tile_count) return;

    // 3D logical mapping from invocations within the workgroup
    // For simplicity, each invocation handles a batch-strided subset
    uint lid   = gl_LocalInvocationID.x;
    uint lsize = gl_WorkGroupSize.x;

    // This shader is dispatched with a 3D logical grid encoded:
    // We re-use WorkGroupID for tile, and local invocations for batch reduction.
    // The host dispatches multiple workgroups to cover (module, hidden, class) combos.
    // Actually, per the OpenCL reference: get_group_id maps to (module_local, h_idx, class_local).
    // In Vulkan single-dispatch the tile_idx IS gl_WorkGroupID.x, but the
    // gradient tensor coordinates are encoded differently.
    //
    // For the Vulkan port: each dispatch covers all tiles. Each workgroup handles
    // one (module_local, h_idx, class_local) triple PER tile via gl_WorkGroupID decomposition.
    //
    // Simplified approach: one workgroup per tile; each invocation strides over batch.
    // The host dispatches per (tile, module_local, h_idx, class_local).

    // Decompose flat tile index
    uint module_chunk_idx  = tile_idx / push.num_class_chunks;
    uint class_chunk_idx   = tile_idx % push.num_class_chunks;

    // For this shader variant, we iterate workgroups over gradient coordinates.
    // Re-map higher WorkGroupID dimensions:
    uint module_local_idx = gl_WorkGroupID.y;
    uint grad_coord       = gl_WorkGroupID.z; // encodes (h_idx, class_local)
    uint h_idx            = grad_coord / push.classes_per_chunk;
    uint class_local_idx  = grad_coord % push.classes_per_chunk;

    if (module_local_idx >= push.modules_per_chunk) return;
    if (h_idx >= push.hidden_count) return;
    if (class_local_idx >= push.classes_per_chunk) return;

    uint module_global_idx = module_chunk_idx * push.modules_per_chunk + module_local_idx;
    COMPUTE_TYPE inv_temp  = COMPUTE_TYPE(1.0) / read_state(src_temps.data[module_global_idx]);
    uint class_global_idx  = class_chunk_idx * push.classes_per_chunk + class_local_idx;

    // Padding Zero-Preservation: skip invocations in final class chunk that exceed logical extent
    if (class_global_idx >= push.total_output_class_count) return;

    // Partial probability base for this tile
    uint64_t prob_tile_base = idx_u64(tile_idx) * idx_u64(push.modules_per_chunk) * idx_u64(push.total_batch_count) * idx_u64(push.classes_per_chunk);

    // Parallel reduction over batch
    COMPUTE_TYPE p_grad_w = COMPUTE_TYPE(0.0);
    COMPUTE_TYPE p_grad_b = COMPUTE_TYPE(0.0);

    for (uint b = lid; b < push.total_batch_count; b += lsize) {
        if (load_sample_mask(src_sample_mask.data[b >> 5u], b) == 0u) continue;

        uint prob_idx = uint(prob_tile_base
                      + idx_u64(module_local_idx) * idx_u64(push.total_batch_count) * idx_u64(push.classes_per_chunk)
                      + idx_u64(b) * idx_u64(push.classes_per_chunk) + idx_u64(class_local_idx));
        COMPUTE_TYPE prob = read_storage(src_probs.data[prob_idx]);

        COMPUTE_TYPE d_loss_d_logit;
        if (SPEC_PROBLEM_TYPE == PROBLEM_TYPE_CCE) {
            int target = src_targets_cce.data[b];
            d_loss_d_logit = (class_global_idx == target) ? (prob - COMPUTE_TYPE(1.0)) : prob;
        } else {
            COMPUTE_TYPE target = read_storage(src_targets_bce.data[b * push.padded_total_output_class_count + class_global_idx]);
            d_loss_d_logit = prob - target;
        }

        // Apply temperature chain rule: dL/dz = dL/dz_s * (1/tau)
        d_loss_d_logit *= inv_temp;

        COMPUTE_TYPE h_val = read_storage(src_hidden.data[b * push.padded_hidden_count + h_idx]);
        p_grad_w += d_loss_d_logit * h_val;

        if (h_idx == 0) {
            p_grad_b += d_loss_d_logit;
        }
    }

    // Workgroup reduction for weight gradient
    COMPUTE_TYPE w_sum = workgroup_reduce_add(p_grad_w);
    if (lid == 0) {
        uint w_tile_base = uint(idx_u64(tile_idx) * idx_u64(push.modules_per_chunk) * idx_u64(push.padded_hidden_count) * idx_u64(push.padded_total_output_class_count));
        uint w_out = uint(idx_u64(w_tile_base)
                   + idx_u64(module_local_idx) * idx_u64(push.padded_hidden_count) * idx_u64(push.padded_total_output_class_count)
                   + idx_u64(h_idx) * idx_u64(push.padded_total_output_class_count)
                   + idx_u64(class_global_idx));
        dest_grad_w.data[w_out] = write_storage(w_sum);
    }

    // Bias gradient (only h_idx == 0 workgroups contribute)
    if (h_idx == 0) {
        COMPUTE_TYPE b_sum = workgroup_reduce_add(p_grad_b);
        if (lid == 0) {
            uint b_tile_base = uint(idx_u64(tile_idx) * idx_u64(push.modules_per_chunk) * idx_u64(push.padded_total_output_class_count));
            uint b_out = uint(idx_u64(b_tile_base) + idx_u64(module_local_idx) * idx_u64(push.padded_total_output_class_count) + idx_u64(class_global_idx));
            dest_grad_b.data[b_out] = write_storage(b_sum);
        }
    }
}
