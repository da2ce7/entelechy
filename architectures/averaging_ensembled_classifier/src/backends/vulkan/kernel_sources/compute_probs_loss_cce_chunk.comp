// compute_probs_loss_cce.comp — Node 6: Softmax probabilities + CCE loss
//
// Algorithmic reference: kernels.cl.h §compute_probs_loss_cce_chunk
// Strategy B — separate shader for CCE (no specialization constant branch).
// Dispatch: vkCmdDispatch(tile_count, 1, 1)
//   gl_WorkGroupID.x → flat tile index
// Each invocation handles one (module_local, batch) pair: computes numerically
// stable softmax over the full class dimension, renders partial probs for its
// tile's class chunk, and scatter-writes the final loss.

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    uint num_class_chunks;
    uint classes_per_chunk;
    uint modules_per_chunk;
    uint total_batch_count;
    uint total_output_class_count;
    uint padded_total_output_class_count;
    uint total_modules_count;
    uint total_tile_count;
} push;

layout(set = 0, binding = 0) readonly buffer LogitsBuf  { STORAGE_TYPE data[]; } src_logits;
layout(set = 0, binding = 1) readonly buffer TempsBuf   { STATE_TYPE   data[]; } src_temps;
layout(set = 0, binding = 2) readonly buffer TargetsBuf { int           data[]; } src_targets;
layout(set = 0, binding = 3) readonly buffer MaskBuf    { STORAGE_TYPE data[]; } src_sample_mask;
layout(set = 0, binding = 4) writeonly buffer ProbsBuf  { STORAGE_TYPE data[]; } dest_probs;
layout(set = 0, binding = 5) writeonly buffer LossBuf   { COMPUTE_TYPE data[]; } dest_loss;

void main() {
    // 2D logical: (module_local, batch) per invocation
    uint gid = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    uint flat_tile_index = gid / (push.modules_per_chunk * push.total_batch_count);
    uint rem = gid % (push.modules_per_chunk * push.total_batch_count);

    // Re-derive: one invocation per (flat_tile, module_local, batch)
    // Actually, the dispatch is simpler: one workgroup per tile, threads cover (module, batch) pairs
    uint tile_idx = gl_WorkGroupID.x;
    if (tile_idx >= push.total_tile_count) return;

    uint local_id = gl_LocalInvocationID.x;
    uint module_local_idx = local_id / push.total_batch_count;
    uint batch_idx        = local_id % push.total_batch_count;

    if (module_local_idx >= push.modules_per_chunk || batch_idx >= push.total_batch_count) return;

    // Decompose flat tile index
    uint module_chunk_idx  = tile_idx / push.num_class_chunks;
    uint module_global_idx = module_chunk_idx * push.modules_per_chunk + module_local_idx;
    uint class_chunk_idx   = tile_idx % push.num_class_chunks;
    uint class_offset      = class_chunk_idx * push.classes_per_chunk;

    // Loss output index
    uint loss_out_idx = module_global_idx * push.total_batch_count + batch_idx;

    // Handle padded samples
    if (read_storage(src_sample_mask.data[batch_idx]) < COMPUTE_TYPE(0.5)) {
        dest_loss.data[loss_out_idx] = COMPUTE_TYPE(0.0);
        uint prob_tile_base = tile_idx * push.modules_per_chunk * push.total_batch_count * push.classes_per_chunk;
        for (uint c_local = 0; c_local < push.classes_per_chunk; ++c_local) {
            uint prob_idx = prob_tile_base
                          + module_local_idx * push.total_batch_count * push.classes_per_chunk
                          + batch_idx * push.classes_per_chunk + c_local;
            dest_probs.data[prob_idx] = write_storage(COMPUTE_TYPE(0.0));
        }
        return;
    }

    // Numerically stable softmax
    COMPUTE_TYPE temp_inv = COMPUTE_TYPE(1.0) / read_state(src_temps.data[module_global_idx]);
    uint base_logits = module_global_idx * push.total_batch_count * push.padded_total_output_class_count
                     + batch_idx * push.padded_total_output_class_count;

    // Pass 1: find max scaled logit
    COMPUTE_TYPE max_scaled_logit = COMPUTE_TYPE(-3.402823466e+38); // -FLT_MAX
    for (uint c = 0; c < push.total_output_class_count; ++c) {
        max_scaled_logit = max(max_scaled_logit, read_storage(src_logits.data[base_logits + c]) * temp_inv);
    }
    if (max_scaled_logit == COMPUTE_TYPE(-3.402823466e+38)) {
        max_scaled_logit = COMPUTE_TYPE(0.0);
    }

    // Pass 2: sum of exponentials
    COMPUTE_TYPE sum_exp = COMPUTE_TYPE(0.0);
    for (uint c = 0; c < push.total_output_class_count; ++c) {
        sum_exp += COMPUTE_EXP(read_storage(src_logits.data[base_logits + c]) * temp_inv - max_scaled_logit);
    }
    COMPUTE_TYPE inv_sum_exp = (sum_exp > NUMERICAL_STABILITY_EPSILON) ? (COMPUTE_TYPE(1.0) / sum_exp) : COMPUTE_TYPE(0.0);

    // Partial probability rendering for this tile's class chunk
    uint prob_tile_base = tile_idx * push.modules_per_chunk * push.total_batch_count * push.classes_per_chunk;
    for (uint c_local = 0; c_local < push.classes_per_chunk; ++c_local) {
        uint c_global = class_offset + c_local;
        if (c_global < push.total_output_class_count) {
            COMPUTE_TYPE logit = read_storage(src_logits.data[base_logits + c_global]);
            COMPUTE_TYPE prob  = COMPUTE_EXP(logit * temp_inv - max_scaled_logit) * inv_sum_exp;
            uint prob_idx = prob_tile_base
                          + module_local_idx * push.total_batch_count * push.classes_per_chunk
                          + batch_idx * push.classes_per_chunk + c_local;
            dest_probs.data[prob_idx] = write_storage(prob);
        }
    }

    // Loss: CCE = -log(prob_true_class)
    int   true_class   = src_targets.data[batch_idx];
    COMPUTE_TYPE logit_true   = read_storage(src_logits.data[base_logits + true_class]);
    COMPUTE_TYPE prob_true    = COMPUTE_EXP(logit_true * temp_inv - max_scaled_logit) * inv_sum_exp;
    dest_loss.data[loss_out_idx] = -COMPUTE_LOG(max(prob_true, NUMERICAL_STABILITY_EPSILON));
}
