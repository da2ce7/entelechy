// clip_partial_gradients.comp — Node 11: Group-wise gradient clipping
//
// Algorithmic reference: kernels.cl.h §clip_partial_gradients
// Two-pass algorithm treating four gradient buffers as a virtual vector:
//   Pass 1: L2 norm via workgroup_reduce_add(sq_sum)
//   Pass 2: conditional scaling to all elements
// Dispatch: vkCmdDispatch(total_tile_count, 1, 1)
//   gl_WorkGroupID.x → flat tile index

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    uint  use_per_item_norm;
    COMPUTE_TYPE clipping_threshold;
    COMPUTE_TYPE epsilon;
    uint  num_class_chunks;
    uint  classes_per_chunk;
    uint  modules_per_chunk;
    uint  total_batch_count;
    uint  padded_hidden_count;
    uint  padded_total_output_class_count;
    uint  total_tile_count;
} push;

layout(set = 0, binding = 0) readonly buffer GradWIn    { STORAGE_TYPE data[]; } src_grad_w;
layout(set = 0, binding = 1) readonly buffer GradBIn    { STORAGE_TYPE data[]; } src_grad_b;
layout(set = 0, binding = 2) readonly buffer GradTIn    { STORAGE_TYPE data[]; } src_grad_temps;
layout(set = 0, binding = 3) readonly buffer GradHIn    { STORAGE_TYPE data[]; } src_grad_h;
layout(set = 0, binding = 4) readonly buffer ThreshBuf  { STORAGE_TYPE data[]; } src_threshold_per_item;
layout(set = 0, binding = 5) writeonly buffer GradWOut  { STORAGE_TYPE data[]; } dest_grad_w;
layout(set = 0, binding = 6) writeonly buffer GradBOut  { STORAGE_TYPE data[]; } dest_grad_b;
layout(set = 0, binding = 7) writeonly buffer GradTOut  { STORAGE_TYPE data[]; } dest_grad_temps;
layout(set = 0, binding = 8) writeonly buffer GradHOut  { STORAGE_TYPE data[]; } dest_grad_h;

// Shared memory for broadcasting scale factor
shared COMPUTE_TYPE _clip_scale;

void main() {
    uint tile_idx = gl_WorkGroupID.x;
    if (tile_idx >= push.total_tile_count) return;

    uint lid   = gl_LocalInvocationID.x;
    uint lsize = gl_WorkGroupSize.x;

    // Per-buffer element counts
    uint64_t n_weights64 = idx_u64(push.modules_per_chunk) * idx_u64(push.padded_hidden_count) * idx_u64(push.padded_total_output_class_count);
    uint64_t n_biases64  = idx_u64(push.modules_per_chunk) * idx_u64(push.padded_total_output_class_count);
    uint64_t n_temps64   = idx_u64(push.modules_per_chunk);
    uint64_t n_hidden64  = idx_u64(push.modules_per_chunk) * idx_u64(push.total_batch_count) * idx_u64(push.padded_hidden_count);
    uint n_weights = uint(n_weights64);
    uint n_biases  = uint(n_biases64);
    uint n_temps   = uint(n_temps64);
    uint n_hidden  = uint(n_hidden64);
    uint total_elements = n_weights + n_biases + n_temps + n_hidden;

    // Base offsets for this tile
    uint w_base = uint(idx_u64(tile_idx) * n_weights64);
    uint b_base = uint(idx_u64(tile_idx) * n_biases64);
    uint t_base = uint(idx_u64(tile_idx) * n_temps64);
    uint h_base = uint(idx_u64(tile_idx) * n_hidden64);

    // Pass 1: sum of squares
    COMPUTE_TYPE local_sq_sum = COMPUTE_TYPE(0.0);
    for (uint i = lid; i < total_elements; i += lsize) {
        COMPUTE_TYPE val;
        if (i < n_weights) {
            val = read_storage(src_grad_w.data[w_base + i]);
        } else if (i < n_weights + n_biases) {
            val = read_storage(src_grad_b.data[b_base + i - n_weights]);
        } else if (i < n_weights + n_biases + n_temps) {
            val = read_storage(src_grad_temps.data[t_base + i - n_weights - n_biases]);
        } else {
            val = read_storage(src_grad_h.data[h_base + i - n_weights - n_biases - n_temps]);
        }
        local_sq_sum += val * val;
    }

    COMPUTE_TYPE total_sq = workgroup_reduce_add(local_sq_sum);

    // Compute scale factor
    // Negative threshold bypasses clipping (diagnostic mode)
    if (lid == 0) {
        COMPUTE_TYPE threshold;
        if (push.use_per_item_norm == 1) {
            threshold = read_storage(src_threshold_per_item.data[tile_idx]);
        } else {
            threshold = COMPUTE_TYPE(push.clipping_threshold);
        }

        COMPUTE_TYPE norm = sqrt(total_sq);
        COMPUTE_TYPE scale = COMPUTE_TYPE(1.0);
        // Only clip if threshold is non-negative; negative threshold = bypass
        if (threshold >= COMPUTE_TYPE(0.0) && norm > threshold) {
            scale = threshold / (norm + COMPUTE_TYPE(push.epsilon));
        }
        _clip_scale = scale;
    }
    barrier();
    COMPUTE_TYPE scale_factor = _clip_scale;

    // Pass 2: conditional scaling → destination
    for (uint i = lid; i < total_elements; i += lsize) {
        if (i < n_weights) {
            dest_grad_w.data[w_base + i] = write_storage(read_storage(src_grad_w.data[w_base + i]) * scale_factor);
        } else if (i < n_weights + n_biases) {
            uint ri = i - n_weights;
            dest_grad_b.data[b_base + ri] = write_storage(read_storage(src_grad_b.data[b_base + ri]) * scale_factor);
        } else if (i < n_weights + n_biases + n_temps) {
            uint ri = i - n_weights - n_biases;
            dest_grad_temps.data[t_base + ri] = write_storage(read_storage(src_grad_temps.data[t_base + ri]) * scale_factor);
        } else {
            uint ri = i - n_weights - n_biases - n_temps;
            dest_grad_h.data[h_base + ri] = write_storage(read_storage(src_grad_h.data[h_base + ri]) * scale_factor);
        }
    }
}
