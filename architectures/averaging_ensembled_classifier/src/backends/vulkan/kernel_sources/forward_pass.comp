// forward_pass.comp — Node 4: Shared-layer forward pass
//
// Algorithmic reference: kernels.cl.h §forward_pass
// Dispatch: vkCmdDispatch(batch_chunk_count, padded_hidden/SIMD_WIDTH, 1)
//   gl_WorkGroupID.x → sample index within chunk
//   gl_WorkGroupID.y → hidden block index

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in; // local_size_x = SPEC_SIMD_WIDTH

// ── Push Constants ─────────────────────────────────────────────────────
layout(push_constant) uniform PushConstants {
    uint batch_chunk_offset;
    uint batch_chunk_count;
    uint total_batch_count;
    uint padded_input_count;
    uint padded_hidden_count;
    uint FLAG_produce_hidden_mask;
} push;

// ── Descriptor Bindings ────────────────────────────────────────────────
layout(set = 0, binding = 0) readonly buffer InputBuf       { STORAGE_TYPE data[]; } src_input;
layout(set = 0, binding = 1) readonly buffer MaskBuf        { uint data[]; } src_sample_mask;
layout(set = 0, binding = 2) readonly buffer WeightsBuf     { STATE_TYPE   data[]; } src_weights;
layout(set = 0, binding = 3) readonly buffer BiasesBuf      { STATE_TYPE   data[]; } src_biases;
layout(set = 0, binding = 4) writeonly buffer HiddenBuf     { STORAGE_TYPE data[]; } dest_hidden;
layout(set = 0, binding = 5) writeonly buffer HiddenMaskBuf { STORAGE_TYPE data[]; } dest_hidden_mask;

// ── Shared Memory Tile (bank-conflict avoidance) ───────────────────────
shared COMPUTE_TYPE simd_tile[SPEC_SIMD_WIDTH][SPEC_SIMD_WIDTH + SPEC_LOCAL_MEM_BANK_PADDING];

void main() {
    uint b_idx = gl_WorkGroupID.x + push.batch_chunk_offset;
    uint hb    = gl_WorkGroupID.y;
    uint lid   = gl_LocalInvocationID.x;

    if (b_idx >= push.total_batch_count) return;

    uint  h_idx      = hb * SPEC_SIMD_WIDTH + lid;
    uint  mask_val   = load_sample_mask(src_sample_mask.data[b_idx >> 5u], b_idx);
    uint  input_base = b_idx * push.padded_input_count;
    uint  w_base     = hb * push.padded_input_count * SPEC_SIMD_WIDTH;

    // Handle padded (masked-out) samples
    if (mask_val == 0u) {
        uint out_idx = b_idx * push.padded_hidden_count + h_idx;
        dest_hidden.data[out_idx]      = write_storage(COMPUTE_TYPE(0.0));
        if (push.FLAG_produce_hidden_mask != 0u) {
            dest_hidden_mask.data[out_idx] = write_storage(COMPUTE_TYPE(0.0));
        }
        return;
    }

    // Initialize accumulator with bias
    COMPUTE_TYPE accum = read_state(src_biases.data[h_idx]);

    // Tiled dot product across input dimension
    for (uint it = 0; it < push.padded_input_count; it += SPEC_SIMD_WIDTH) {
        // Cooperatively load weight tile into shared memory
        for (uint k = 0; k < SPEC_SIMD_WIDTH; k++) {
            simd_tile[lid][k] = read_state(src_weights.data[w_base + (it + lid) * SPEC_SIMD_WIDTH + k]);
        }
        barrier();

        // Column-wise access → bank-conflict-free due to padding
        for (uint j = 0; j < SPEC_SIMD_WIDTH; j++) {
            COMPUTE_TYPE x = read_storage(src_input.data[input_base + it + j]);
            accum = fma(simd_tile[j][lid], x, accum);
        }
        barrier();
    }

    // ReLU activation (sample already validated as active)
    COMPUTE_TYPE activated = max(COMPUTE_TYPE(0.0), accum);
    COMPUTE_TYPE rmask     = (accum > COMPUTE_TYPE(0.0)) ? COMPUTE_TYPE(1.0) : COMPUTE_TYPE(0.0);

    uint out_idx = b_idx * push.padded_hidden_count + h_idx;
    dest_hidden.data[out_idx] = write_storage(activated);
    if (push.FLAG_produce_hidden_mask != 0u) {
        dest_hidden_mask.data[out_idx] = write_storage(rmask);
    }
}
