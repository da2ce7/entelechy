// clamp_temperatures.comp — Node 25: Temperature parameter clamping
//
// Algorithmic reference: kernels.cl.h §clamp_temperatures
// Embarrassingly parallel element-wise kernel.
// Clamps learnable temperature parameters to [min, max] range,
// preventing numerical instability in Softmax/Sigmoid computations.
//
// ADR-030: Buffer is indexed via [parameter_offset + i].
// The slice access invariant ensures no out-of-bounds access.
//
// Dispatch: vkCmdDispatch(ceil(parameter_count / SIMD_WIDTH), 1, 1)

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    float min_value;
    float max_value;
    uint  parameter_offset;
    uint  parameter_count;
    uint  total_parameter_count;
} push;

layout(set = 0, binding = 0) buffer TempsBuf { STATE_TYPE data[]; } temps;

void main() {
    uint idx = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (idx >= push.parameter_count) return;

    // ADR-030: Compute the actual index into the state buffer
    uint state_idx = push.parameter_offset + idx;

    COMPUTE_TYPE val = read_state(temps.data[state_idx]);
    temps.data[state_idx] = write_state(clamp(val, COMPUTE_TYPE(push.min_value), COMPUTE_TYPE(push.max_value)));
}
