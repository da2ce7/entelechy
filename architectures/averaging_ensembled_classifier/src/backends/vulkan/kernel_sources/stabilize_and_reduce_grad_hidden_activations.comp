// stabilize_reduce_grad_h.comp — Node 16: Stabilized Grad_H reduction
//
// Algorithmic reference: kernels.cl.h §stabilize_and_reduce_grad_hidden_activations
// Parametric reduction engine. Receives a host-prescribed threshold schedule and
// applies it. Each workgroup reduces one row of the permuted SoA grad_hidden buffer
// (batch × padded_hidden) across all modules.
//
// Strategy: "work-group per row" model.
//   Phase 1: Pre-accumulation — each thread reduces assigned elements, clips to t_pre.
//   Phase 2: Staged binary-tree reduction with per-stage prescribed thresholds.
//   Phase 3: Write final reduced scalar to output.
//
// Dispatch: vkCmdDispatch(total_batch_count * padded_hidden_count, 1, 1)

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    uint  num_reduction_stages;
    float clipping_threshold_t_pre;
    float epsilon;
    uint  total_batch_count;
    uint  padded_hidden_count;
    uint  total_modules_count;
    uint  padded_total_modules_count;
} push;

layout(set = 0, binding = 0) readonly buffer SrcGradH    { STORAGE_TYPE data[]; } src_grad_h;
layout(set = 0, binding = 1) writeonly buffer DestGradH   { COMPUTE_TYPE data[]; } dest_grad_h;
layout(set = 0, binding = 2) readonly buffer ThresholdBuf { COMPUTE_TYPE data[]; } threshold_schedule;

// Local scratch for the staged reduction. Must accommodate full workgroup size.
shared COMPUTE_TYPE reduction_tile[1024];

void main() {
    uint row_idx = gl_WorkGroupID.x;
    uint lid     = gl_LocalInvocationID.x;
    uint lsize   = gl_WorkGroupSize.x;

    uint total_rows = push.total_batch_count * push.padded_hidden_count;
    if (row_idx >= total_rows) return;

    // ── Phase 1: Pre-accumulation ──
    // Each thread accumulates ceil(total_modules_count / lsize) elements,
    // then clips to the host-prescribed pre-accumulation threshold.
    COMPUTE_TYPE thread_accum = COMPUTE_TYPE(0.0);
    uint row_offset = row_idx * push.padded_total_modules_count;
    for (uint i = lid; i < push.total_modules_count; i += lsize) {
        thread_accum += read_storage(src_grad_h.data[row_offset + i]);
    }

    // Pre-accumulation clip (host-prescribed threshold).
    COMPUTE_TYPE mag = abs(thread_accum);
    if (mag > COMPUTE_TYPE(push.clipping_threshold_t_pre)) {
        thread_accum *= COMPUTE_TYPE(push.clipping_threshold_t_pre) / (mag + COMPUTE_TYPE(push.epsilon));
    }

    reduction_tile[lid] = thread_accum;
    barrier();

    // ── Phase 2: Staged binary-tree reduction ──
    // Apply the host-prescribed per-stage threshold schedule.
    for (uint s = 0; s < push.num_reduction_stages; ++s) {
        COMPUTE_TYPE threshold = threshold_schedule.data[s];

        uint stride = 1u << s;
        uint pair   = 2u * stride;
        if (lid % pair == 0 && lid + stride < lsize) {
            COMPUTE_TYPE sum_val = reduction_tile[lid] + reduction_tile[lid + stride];

            COMPUTE_TYPE norm = abs(sum_val);
            if (norm > threshold) {
                sum_val *= threshold / (norm + COMPUTE_TYPE(push.epsilon));
            }
            reduction_tile[lid] = sum_val;
        }

        barrier();
    }

    // ── Phase 3: Final write ──
    if (lid == 0) {
        dest_grad_h.data[row_idx] = reduction_tile[0];
    }
}
