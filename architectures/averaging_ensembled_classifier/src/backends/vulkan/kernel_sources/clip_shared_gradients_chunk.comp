// clip_shared_gradients.comp — Node 19: Clip shared weight & bias gradients
//
// Algorithmic reference: kernels.cl.h §clip_shared_gradients_chunk
// Virtual-vector L2 norm clipping across weight and bias gradient buffers.
// Two-pass: (1) compute joint L2 norm, (2) conditionally scale both buffers.
// Output written to host-specified destination offsets (placement contract).
//
// Dispatch: vkCmdDispatch(1, 1, 1) — single workgroup.
// Dispatched per streaming chunk.

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    float clipping_threshold;  // < 0 bypasses clipping (diagnostic mode)
    float epsilon;
    uint  weights_parameter_count;
    uint  biases_parameter_count;
    uint  weights_write_offset;
    uint  biases_write_offset;
    uint  num_batch_chunks;
} push;

layout(set = 0, binding = 0) readonly buffer SrcGradW  { STORAGE_TYPE data[]; } src_grad_w;
layout(set = 0, binding = 1) readonly buffer SrcGradB  { STORAGE_TYPE data[]; } src_grad_b;
layout(set = 0, binding = 2) writeonly buffer DstGradW { STORAGE_TYPE data[]; } dst_grad_w;
layout(set = 0, binding = 3) writeonly buffer DstGradB { STORAGE_TYPE data[]; } dst_grad_b;

void main() {
    uint lid   = gl_LocalInvocationID.x;
    uint lsize = gl_WorkGroupSize.x;
    uint total_elements = push.weights_parameter_count + push.biases_parameter_count;

    // Diagnostic bypass: negative threshold copies without clipping
    if (push.clipping_threshold < 0.0) {
        for (uint i = lid; i < total_elements; i += lsize) {
            if (i < push.weights_parameter_count) {
                dst_grad_w.data[push.weights_write_offset + i] = src_grad_w.data[i];
            } else {
                uint rel = i - push.weights_parameter_count;
                dst_grad_b.data[push.biases_write_offset + rel] = src_grad_b.data[rel];
            }
        }
        return;
    }

    // ── Pass 1: Compute sum of squares for joint L2 norm ──
    COMPUTE_TYPE local_sq_sum = COMPUTE_TYPE(0.0);
    for (uint i = lid; i < total_elements; i += lsize) {
        COMPUTE_TYPE val;
        if (i < push.weights_parameter_count) {
            val = read_storage(src_grad_w.data[i]);
        } else {
            val = read_storage(src_grad_b.data[i - push.weights_parameter_count]);
        }
        local_sq_sum += val * val;
    }

    COMPUTE_TYPE total_sq = workgroup_reduce_add(local_sq_sum);

    // ── Compute scaling factor and broadcast ──
    COMPUTE_TYPE scale_factor;
    if (lid == 0) {
        COMPUTE_TYPE norm = sqrt(total_sq);
        scale_factor = COMPUTE_TYPE(1.0);
        if (norm > COMPUTE_TYPE(push.clipping_threshold)) {
            scale_factor = COMPUTE_TYPE(push.clipping_threshold) / (norm + COMPUTE_TYPE(push.epsilon));
        }
        _compute_scratch[0] = scale_factor;
    }
    barrier();
    scale_factor = _compute_scratch[0];

    // ── Pass 2: Scale and write to destination offsets ──
    for (uint i = lid; i < total_elements; i += lsize) {
        if (i < push.weights_parameter_count) {
            COMPUTE_TYPE val = read_storage(src_grad_w.data[i]);
            dst_grad_w.data[push.weights_write_offset + i] = write_storage(val * scale_factor);
        } else {
            uint  rel = i - push.weights_parameter_count;
            COMPUTE_TYPE val = read_storage(src_grad_b.data[rel]);
            dst_grad_b.data[push.biases_write_offset + rel] = write_storage(val * scale_factor);
        }
    }
}
