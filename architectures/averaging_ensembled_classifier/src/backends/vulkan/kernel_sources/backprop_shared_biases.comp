// backprop_shared_biases.comp — Node 18: Shared bias gradients (streaming)
//
// Algorithmic reference: kernels.cl.h §backprop_shared_biases_chunk
// "Work-group per gradient" reduction for 1D bias vector.
// Each workgroup computes one scalar gradient dL/dB_j by reducing
// contributions across all samples in a batch chunk.
//
// Dispatch: vkCmdDispatch(padded_hidden_count, 1, 1)
//   gl_WorkGroupID.x → hidden dimension (j_idx)
// Dispatched per streaming chunk; batch_chunk_offset/index updated via push constants.

#version 450
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant) uniform PushConstants {
    uint batch_chunk_offset;
    uint batch_chunk_count;
    uint batch_chunk_index;
    uint total_batch_count;
    uint num_batch_chunks_count;
    uint padded_hidden_count;
    uint final_grad_hidden_total_element_count;
} push;

layout(set = 0, binding = 0) readonly buffer HiddenBuf     { float data[]; } hidden_acts;
layout(set = 0, binding = 1) readonly buffer GradHBuf      { float data[]; } grad_h;
layout(set = 0, binding = 2) readonly buffer SampleMaskBuf { float data[]; } sample_mask;
layout(set = 0, binding = 3) writeonly buffer GradSBOut    { float data[]; } grad_sb_out;

void main() {
    uint j_idx = gl_WorkGroupID.x;
    uint lid   = gl_LocalInvocationID.x;
    uint lsize = gl_WorkGroupSize.x;

    if (j_idx >= push.padded_hidden_count) return;

    // ── Parallel reduction over the batch chunk ──
    float p_grad_sb = 0.0;

    for (uint b_local = lid; b_local < push.batch_chunk_count; b_local += lsize) {
        uint b_global = push.batch_chunk_offset + b_local;

        if (sample_mask.data[b_global] < 0.5) continue;

        // Chain rule: dL/dB_j = (dL/dA_j) * (dA_j/dZ_j) * 1
        // For biases, dZ_j/dB_j = 1.
        uint  hidden_offset = b_global * push.padded_hidden_count + j_idx;
        float grad_h_val    = grad_h.data[hidden_offset];
        float hidden_val    = hidden_acts.data[hidden_offset];

        // ReLU derivative
        float d_activation = (hidden_val > 0.0) ? 1.0 : 0.0;
        p_grad_sb += grad_h_val * d_activation;
    }

    // ── Subgroup-accelerated workgroup reduction ──
    float total = workgroup_reduce_add(p_grad_sb);

    if (lid == 0) {
        uint chunk_base = push.batch_chunk_index * push.padded_hidden_count;
        grad_sb_out.data[chunk_base + j_idx] = total;
    }
}
